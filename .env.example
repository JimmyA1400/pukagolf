# Copy to .env.local and fill in. Nothing here belongs in git: .gitignore
# covers .env*, and this example file is the one deliberate exception.

# ---------------------------------------------------------------- the app
# Both come from your Supabase project: Dashboard -> Project Settings ->
# Data API. Both are safe in the browser. The anon key is public by design;
# every rule that matters is enforced by row level security in the database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------- the owner
# The account that owns the league: the one that can reset a week, start the
# next one, and decide who is an admin. Migration 0029 reads this as
# app.owner_email rather than carrying an address in the repo, so set it for
# the session that runs the migrations:
#
#   psql "$DATABASE_URL" -c "set app.owner_email = '$LEAGUE_OWNER_EMAIL'" -f supabase/migrations/0029_league_owner.sql
#
# or leave it unset and run supabase/seed/owner.local.sql afterwards. See
# supabase/seed/owner.local.sql.example.
LEAGUE_OWNER_EMAIL=user@example.com

# ------------------------------------------------- the test database only
# Your TEST Supabase project id. scripts/testers/session.mjs refuses to run
# until it can prove the page it signed into is the test database and not
# live, and this is how it tells.
TESTER_TEST_REF=

# Your LIVE Supabase project id. Only ever used to recognise live and refuse
# to write to it (scripts/test-db/common.ps1, Assert-NotLive). The scripts
# that write stop rather than guess when this is missing. A plain file at
# scripts/test-db/live-ref.local.txt works too.
PUKAGOLF_LIVE_PROJECT_REF=

# Where the browser tests point. Defaults to http://localhost:3000.
# TESTER_BASE_URL=http://localhost:3000
